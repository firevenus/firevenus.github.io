---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
---

<BaseLayout title={title}>
  <header class="post-header">
    <h1>{title}</h1>
    <time class="post-date" datetime={date.toISOString()}>
      {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
  </header>
  <article class="post-body">
    <slot />
  </article>
</BaseLayout>

<style>
  .post-header {
    text-align: center;
    padding: 60px 0 16px;
    margin-bottom: 40px;
  }
  .post-header h1 {
    font-size: 2.2em;
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 12px;
    color: #111;
  }
  .post-date {
    color: #888;
    font-size: 0.95em;
  }
  .post-body {
    padding-bottom: 60px;
  }
  @media (max-width: 640px) {
    .post-header { padding: 40px 0 12px; }
    .post-header h1 { font-size: 1.6em; }
  }
</style>

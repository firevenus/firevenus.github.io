---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面不存在" noindex={true}>
  <div class="nf">
    <p class="code">404</p>
    <h1>这条轨道上没有东西</h1>
    <p class="desc">页面可能已经搬走，或者链接本身写错了。</p>
    <div class="actions">
      <a href="/" class="btn">回首页</a>
      <a href="/desk/" class="btn ghost">去工作台</a>
      <a href="/morning/" class="btn ghost">看今日晨报</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    text-align: center;
    padding: 100px 0 80px;
  }
  .code {
    font-size: 4em;
    font-weight: 800;
    color: #e5e7eb;
    line-height: 1;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
  }
  .nf h1 {
    font-size: 1.5em;
    font-weight: 700;
    color: #111;
    margin: 0 0 10px;
  }
  .desc {
    color: #777;
    margin: 0 0 28px;
    font-size: 0.95em;
  }
  .actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 10px 22px;
    border-radius: 8px;
    font-size: 0.92em;
    font-weight: 600;
    background: #2563eb;
    color: #fff;
  }
  .btn.ghost {
    background: #f1f5f9;
    color: #333;
  }
  .btn:hover {
    border-bottom-color: transparent;
    opacity: 0.9;
  }
</style>
